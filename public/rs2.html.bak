<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=0.7" />
  <title>LC-rs2 r377 (local)</title>
  <style>
    body { margin: 0; background: #000; color: #fff; font-family: Arial, Helvetica, sans-serif; font-size: 12px; }
    center {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }
    /* Client-TS Canvas.ts: document.getElementById('canvas') — id MUST be "canvas" */
    #canvas {
      width: 765px;
      height: 503px;
      image-rendering: pixelated;
      display: block;
      outline: none;
      -webkit-user-select: none;
      user-select: none;
    }
  </style>
</head>
<body>
  <center>
    <p>LC-rs2 r377 — isolated (node 37, web :81). Open console if blank after this fix.</p>
    <canvas id="canvas" width="765" height="503"></canvas>
  </center>
  <script type="module">
    try {
      const params = new URLSearchParams(location.search);
      const harness = params.has('harness');
      const { Client } = await import('/client/client.js?v=1785816983');
      // nodeid, lowmem, members
      const client = new Client(37, false, true);

      // Deploy-shell only: keep a ref for tools/harness. Never lives inside Client-TS.
      if (harness) {
        const { install } = await import('/harness/attach-in-page.js');
        install(client);
      }
    } catch (e) {
      console.error('Client failed to start', e);
      const pre = document.createElement('pre');
      pre.style.color = 'yellow';
      pre.style.maxWidth = '90vw';
      pre.style.whiteSpace = 'pre-wrap';
      pre.textContent = String(e && e.stack ? e.stack : e);
      document.body.appendChild(pre);
    }
  </script>
</body>
</html>
